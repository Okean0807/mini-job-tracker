# Copy to .env and fill with your Lovable/Supabase project values.
# Never commit a real .env (see .gitignore).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only — set in platform secrets (e.g. Vercel), never commit real values, never VITE_*:
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tavily Free web search (primary for current legal/factual checks). Never VITE_*.
# Free tier only in production path — no credit card / paygo / auto-upgrade in code.
TAVILY_API_KEY=

# Feedback (server-only, never VITE_*). Names only - set real values in the platform secrets.
# FEEDBACK_TRUST_PROXY=vercel  -> trust the rightmost x-forwarded-for entry (only behind Vercel's edge).
#   Unset/anything else -> no client IP is trusted and Feedback submissions are refused (fail closed).
FEEDBACK_TRUST_PROXY=
# At least 32 characters with at least 12 distinct ones; generate with: openssl rand -hex 32
FEEDBACK_HASH_SECRET=
