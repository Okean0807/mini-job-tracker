# Copy to .env and fill with your Lovable/Supabase project values.
# Never commit a real .env (see .gitignore).

# ---------------------------------------------------------------------------
# Build profile (required: `scripts/assert-build-profile.mjs` stops the build without it).
# MJC_BUILD_PROFILE must be exactly one of: public-local | cloud-enabled | d41-pilot
#
#  public-local  : no cloud. Leave ALL Supabase / Gemini / Tavily variables and the
#                  MJC_*_SUPABASE_REF variables UNSET; AI_FEATURES_ENABLED unset or "false";
#                  CLOUD_SYNC_ENABLED / VITE_CLOUD_SYNC_ENABLED unset, empty or "false".
#                  "true" or any ambiguous value (TRUE, 1, yes, " true" ...) stops the build.
#  cloud-enabled : CLOUD_SYNC_ENABLED and VITE_CLOUD_SYNC_ENABLED both exactly "true";
#                  Supabase URL + publishable key; MJC_EXPECTED_SUPABASE_REF must match the
#                  project ref in the URL (https://<ref>.supabase.co).
#  d41-pilot     : same as cloud-enabled, plus MJC_DENIED_SUPABASE_REFS (comma separated refs
#                  that must never be used, kept outside the repository); no service-role key
#                  and no AI variables in the build environment.
# Flags are ON only for the exact string "true" (no trimming, no case folding).
# Vite also reads .env files: the build gate scans them as well. Variable values are never printed.
MJC_BUILD_PROFILE=
CLOUD_SYNC_ENABLED=
VITE_CLOUD_SYNC_ENABLED=
MJC_EXPECTED_SUPABASE_REF=
MJC_DENIED_SUPABASE_REFS=
# ---------------------------------------------------------------------------

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only — set in platform secrets (e.g. Vercel), never commit real values, never VITE_*:
SUPABASE_SERVICE_ROLE_KEY=
# Master switch for ALL external AI (Gemini + Tavily). Server-only, never VITE_*.
# On only for the exact value "true"; unset or anything else = AI off (free launch default).
# Re-enable only after the separate legal review — see docs/AI_FEATURE_FLAG.md.
AI_FEATURES_ENABLED=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tavily Free web search (primary for current legal/factual checks). Never VITE_*.
# Free tier only in production path — no credit card / paygo / auto-upgrade in code.
TAVILY_API_KEY=
