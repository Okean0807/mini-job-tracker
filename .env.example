# Copy to .env and fill with your Lovable/Supabase project values.
# Never commit a real .env (see .gitignore).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only — set in platform secrets (e.g. Vercel), never commit real values, never VITE_*:
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
