# Copy to .env and fill with your Lovable/Supabase project values.
# Never commit a real .env (see .gitignore).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only — set in platform secrets (e.g. Vercel), never commit real values, never VITE_*:
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tavily Free web search (primary for current legal/factual checks). Never VITE_*.
# Free tier only in production path — no credit card / paygo / auto-upgrade in code.
TAVILY_API_KEY=

# Feedback e-mail (server only, never VITE_*, never committed). Without these the feedback form
# answers "unavailable" and sends nothing. Feedback never uses SUPABASE_SERVICE_ROLE_KEY.
RESEND_API_KEY=
# Single owner address that receives the messages (users cannot choose it).
FEEDBACK_TO_EMAIL=
# Optional sender, e.g. "MiniJob Companion <feedback@your-verified-domain>". Default is the Resend
# test sender, which only delivers to the Resend account owner's own address.
FEEDBACK_FROM_EMAIL=
